{
  "seed": 0,
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "data": {
    "train": "data/boolq_e0/train.jsonl",
    "val": "data/boolq_e0/val.jsonl",
    "test": "data/boolq_e0/test.jsonl",
    "classes": [
      "a",
      "b"
    ],
    "label_mode": "index",
    "label_field": "label",
    "n_options_field": "n_options",
    "prompt_field": "prompt",
    "id_field": "id",
    "question_field": "question",
    "tools_field": "tools",
    "group_field": "group_id",
    "val_fraction": 0.0,
    "test_fraction": 0.0,
    "max_examples": null
  },
  "template": {
    "text": "{question}",
    "tool_format": "- {name}\n  description: {description}\n  parameters: {parameters}",
    "empty_tools": "(none)"
  },
  "backbones": [
    {
      "key": "encoder",
      "name": "jhu-clsp/ettin-encoder-68m",
      "path": "/mnt/local-disk/decision-models/models/ettin-encoder-68m",
      "dtype": "float32"
    },
    {
      "key": "decoder",
      "name": "jhu-clsp/ettin-decoder-68m",
      "path": "/mnt/local-disk/decision-models/models/ettin-decoder-68m",
      "dtype": "float32"
    }
  ],
  "features": {
    "batch_size": 8,
    "max_length": 512,
    "pooling": "last",
    "layers": [
      0,
      6,
      11,
      12,
      17,
      22
    ],
    "device": "cuda:1",
    "cache_dir": "runs/features_boolq_e0",
    "trust_remote_code": false
  },
  "finetune": {
    "device": "cuda:1",
    "max_length": 512,
    "batch_size": 8,
    "eval_batch_size": 16,
    "grad_accum": 2,
    "lr": 2e-05,
    "weight_decay": 0.01,
    "warmup_ratio": 0.06,
    "dropout": 0.1,
    "grad_clip": 1.0,
    "patience": 3,
    "max_epochs_by_fraction": {
      "0.05": 20,
      "0.1": 15,
      "0.25": 10,
      "0.5": 8,
      "1.0": 6
    },
    "readouts": [
      "attn-L18",
      "attn-L12"
    ],
    "autocast": false
  },
  "fractions": [
    0.05,
    0.1,
    0.25,
    0.5,
    1.0
  ],
  "eval": {
    "bootstrap": 2000,
    "n_bins": 10,
    "alpha": 0.05
  },
  "out": "runs/e2_boolq_68m"
}